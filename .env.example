# Copy to .env and adjust. Used by docker-compose.

# Optional shared secret for the web UI. Empty = no auth (fine on a private
# tailnet). When set, enter it in the UI under the ⚙️ settings panel.
ECHO_WEB_TOKEN=

# Which host interface docker-compose binds the published port to.
# 127.0.0.1 = localhost only; the host's Caddy reverse-proxies your domain to
# it. Keep this unless you proxy from another host.
HOST_BIND=127.0.0.1
PORT=8080

# Only needed if you select the OpenAI engine in the UI.
OPENAI_API_KEY=

# Auto-cleanup of generated audio. 0 = keep forever (default).
# Delete finished jobs older than this many days:
ECHO_RETENTION_DAYS=30
# And/or keep only the newest N finished jobs (0 = no limit):
ECHO_MAX_JOBS=0

# Sync each finished job's audio to Google Drive (or any rclone remote).
# Requires a working ./rclone.conf mounted into the container (see
# docker-compose.yml volumes) and the rclone remote already authorized.
# See docs/deploy_vps.md for the one-time setup.
ECHO_SYNC_ENABLED=false
ECHO_SYNC_METHOD=rclone
# rclone remote + folder to upload into (My Drive folder, NOT a Computers backup):
ECHO_SYNC_DEST=gdrive:echoEnglish
# run_folder = one YYYY-MM-DD_HH-MM-SS_<Lang> subfolder per job; flat = no subfolder.
ECHO_SYNC_LAYOUT=run_folder
# Also upload the matching .lrc subtitle file alongside each audio file.
ECHO_SYNC_INCLUDE_LRC=true
