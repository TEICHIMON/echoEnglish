# Copy to .env and adjust. Used by docker-compose.

# Optional shared secret for the web UI. Empty = no auth (fine on a private
# tailnet). When set, enter it in the UI under the ⚙️ settings panel.
ECHO_WEB_TOKEN=

# Which host interface docker-compose binds the published port to.
# 127.0.0.1 = localhost only; the host's Caddy reverse-proxies your domain to
# it. Keep this unless you proxy from another host.
HOST_BIND=127.0.0.1
PORT=8080

# Only needed if you select the OpenAI engine in the UI.
OPENAI_API_KEY=

# Auto-cleanup of generated audio. 0 = keep forever (default).
# Delete finished jobs older than this many days:
ECHO_RETENTION_DAYS=0
# And/or keep only the newest N finished jobs (0 = no limit):
ECHO_MAX_JOBS=0
