# =============================================================================
# Echo 工具链的路径配置 —— 唯一真源
#
# ~/bin 下的 echo_pipeline / echo_pipeline_openai / echo_pipeline_translate /
# extract_audio 都 source 这个文件。搬家时只改这里。
#
# 这个文件存在的原因：这组路径原本被复制粘贴进了 4 个脚本，2026-08 把
# echoEnglish 从 /Volumes/SP 迁到本机时只改了其中 1 个，另外 3 个指向的
# /Volumes/SP/code/python/echoEnglish 被删掉后静默失效了很久。
# =============================================================================

# 都用 ${VAR:-default} 形式，这样环境变量可以临时覆盖（测试、指向别的 checkout）。
# subtitle-automation：whisper 调用 + 分句 + 翻译 + 同步（TypeScript / npm）
SUBTITLE_DIR="${SUBTITLE_DIR:-$HOME/WebstormProjects/subtitle-automation}"

# echoEnglish：双语 LRC + 音频 → Echo Loop 音频（Python）
ECHO_DIR="${ECHO_DIR:-$HOME/PycharmProjects/echoEnglish}"

# echoEnglish 的 conda 环境解释器。写死完整路径，不依赖 shell 的 PATH
# 是否已经 activate 了 echo_env。
ECHO_PYTHON="${ECHO_PYTHON:-/opt/homebrew/anaconda3/envs/echo_env/bin/python}"

# =============================================================================
# echo_pipeline 的生成参数
#
# 这些**不从 echoEnglish 的 config.yaml 读**：那份配置由 web UI 共用，音量和同步
# 策略仍与 shell 流水线不同。循环默认值则刻意保持一致：1×T-N-T + 1×T-S-T，
# 拆成两个文件。两边都可以独立覆盖，不是硬编码限制。
#
# 下面每个都可以被环境变量临时覆盖，改配置和临时试一次都不用动脚本：
#     ECHO_SPLIT_OUTPUTS=true echo_pipeline
#     ECHO_VARIANT=shadow echo_pipeline --echo /some/folder
# =============================================================================

ECHO_ENGINE="${ECHO_ENGINE:-google}"

# 中文旁白音色；目标语音色按文件夹名里的 English / Japanese 选。
ECHO_NATIVE_VOICE="${ECHO_NATIVE_VOICE:-cmn-CN-Chirp3-HD-Kore}"
ECHO_TARGET_VOICE_EN="${ECHO_TARGET_VOICE_EN:-en-US-Neural2-F}"
ECHO_TARGET_VOICE_JA="${ECHO_TARGET_VOICE_JA:-ja-JP-Neural2-B}"

# 循环形态。full=1×T-N-T / shadow=1×T-S-T / progressive=两者都有。
ECHO_VARIANT="${ECHO_VARIANT:-progressive}"
ECHO_TNT_REPEATS="${ECHO_TNT_REPEATS:-1}"
ECHO_TST_REPEATS="${ECHO_TST_REPEATS:-1}"
ECHO_GAIN="${ECHO_GAIN:--10}"

# true = 一次出 _tnt 和 _tst 两个文件。TTS 只生成一次两边共用，不额外花钱。
# 命令行 --split / --no-split 可覆盖。
ECHO_SPLIT_OUTPUTS="${ECHO_SPLIT_OUTPUTS:-true}"

# -----------------------------------------------------------------------------
# 校验：路径失效时立刻报错，而不是等 cd 失败后继续跑出一堆莫名其妙的错误。
# 脚本 source 本文件后调用 echo_paths_require 即可。
# -----------------------------------------------------------------------------
echo_paths_require() {
    local missing=0
    local name path
    for name in "$@"; do
        eval "path=\${$name:-}"
        if [[ -z "$path" ]]; then
            echo "❌ $name 未设置（检查 ~/.config/echo/paths.env）" >&2
            missing=1
        elif [[ ! -e "$path" ]]; then
            echo "❌ $name 指向的路径不存在: $path" >&2
            echo "   在 ~/.config/echo/paths.env 里修正它。" >&2
            missing=1
        fi
    done
    [[ $missing -eq 0 ]] || return 1
}
